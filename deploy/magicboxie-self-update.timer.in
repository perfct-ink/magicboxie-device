# Template for /etc/systemd/system/magicboxie-self-update.timer - rendered
# and enabled by `make pi-self-update-service`. No placeholders to fill in
# (unlike the .service.in next to this), so that target just copies it
# as-is rather than piping it through sed.
#
# Fires magicboxie-self-update.service once a day. Persistent=true means a
# run the device missed entirely - powered off, or offline, at the
# scheduled time - fires as soon as the timer next gets a chance to run
# instead of being skipped until the following day. The service tolerates
# offline git-pull failures; the daily timer supplies later retries. Startup
# also requests an update after joining saved Wi-Fi. RandomizedDelaySec
# spreads daily pulls over an hour to stagger requests to the Git remote.
[Unit]
Description=Run MagicBoxie's daily self-update

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target

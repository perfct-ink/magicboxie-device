# Template for /etc/systemd/system/magicboxie-device.service - installed and
# filled in by `make pi-service` (placeholders substituted with sed).
# Runs the daemon natively on the Pi: BLE + HDMI/DRM output, no Docker.
[Unit]
Description=MagicBoxie device daemon
After=bluetooth.target network.target dbus.service
Wants=bluetooth.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONPATH=@REPO_DIR@
Environment=MAGICBOXIE_TRANSPORT=ble
Environment=MAGICBOXIE_PORTAL_PORT=80
Environment=MAGICBOXIE_MOVIES_DIR=@MOVIES_DIR@
Environment=MAGICBOXIE_THUMBNAIL_DIR=@THUMBNAIL_DIR@
Environment=MAGICBOXIE_TRANSCODE_DIR=@TRANSCODE_DIR@
Environment=MAGICBOXIE_HOME_SERVER_URL=@HOME_SERVER_URL@
Environment=MAGICBOXIE_HOME_SERVER_PASSWORD=@HOME_SERVER_PASSWORD@
# Bluetooth's rfkill soft-block state is persisted independently of this
# service (systemd-rfkill saves/restores it across reboots) - unblock it
# unconditionally on every start so BLE doesn't silently disappear after a
# power cycle. "-" prefix: don't fail the whole unit if rfkill is missing
# or there's nothing to unblock.
ExecStartPre=-/usr/sbin/rfkill unblock bluetooth
ExecStart=@REPO_DIR@/.venv/bin/magicboxie-device
Restart=on-failure
RestartSec=2

# DRM/KMS output + evdev keyboard input + BlueZ D-Bus - see `make pi-setup`,
# which adds @USER@ to these groups. CAP_NET_ADMIN lets the ExecStartPre
# rfkill unblock above work without running the whole service as root.
SupplementaryGroups=video input bluetooth
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

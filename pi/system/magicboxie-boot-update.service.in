# Template for /etc/systemd/system/magicboxie-boot-update.service - rendered
# and enabled by `make self-update-service`.
# Runs as root (so it can start the updater without a sudo prompt) once per boot, independently of magicboxie-player.service (nothing
# waits on it, so playback and the hotspot start regardless). Waits up to
# 30 seconds for internet over any interface, then queues a self-update; with
# no internet it gives up and the device carries on with its current code.
[Unit]
Description=MagicBoxie boot-time update check
After=network.target

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/make -C @REPO_DIR@ boot-update
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target

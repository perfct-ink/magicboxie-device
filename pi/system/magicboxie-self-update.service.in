# Template for /etc/systemd/system/magicboxie-self-update.service - rendered
# and enabled (via its companion .timer) by `make self-update-service`.
# Oneshot: runs after startup connects to saved Wi-Fi and once a day
# (see the .timer). Pulls the latest code and, only if
# that pull actually brought in new commits, waits for nothing to be
# playing and then restarts magicboxie-player.service - see the
# `self-update`/`wait-until-idle` Makefile targets for the actual
# logic, kept there (rather than inlined here) alongside every other pi-*
# target. No timeout on that wait, so this can legitimately run for a long
# time on a day an update lands mid-movie - that's fine for a oneshot.
[Unit]
Description=MagicBoxie self-update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/make -C @REPO_DIR@ self-update

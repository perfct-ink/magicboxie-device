# Template for /etc/systemd/system/magicboxie-self-update.service - rendered
# and enabled (via its companion .timer) by `make self-update-service`.
# Oneshot: runs after startup connects to saved Wi-Fi and once a day
# (see the .timer). Pulls the latest code and, only if that pull brought in
# new commits, installs it right away and restarts magicboxie-player.service
# (any movie is stopped and resumes after the restart) - see the `self-update`
# Makefile target for the actual logic, kept there alongside every other pi-*
# target.
[Unit]
Description=MagicBoxie self-update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/make -C @REPO_DIR@ self-update
